{
	"name": "chamfer",
	"private": true,
	"version": "0.1.0",
	"description": "A spherical voxel world built on a Goldberg polyhedron",
	"license": "UNLICENSED",
	"engines": {
		"node": ">=22"
	},
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"dev": "npm run dev --workspace @chamfer/client",
		"build": "npm run build --workspace @chamfer/client",
		"preview": "npm run preview --workspace @chamfer/client",
		"typecheck": "tsc --build --force",
		"test": "vitest run",
		"test:watch": "vitest",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"docs": "node tools/build-docs.js",
		"figures": "node tools/make-figures.js",
		"reference": "node tools/make-reference.js",
		"coverage": "node tools/check-coverage.js",
		"style": "node tools/check-style.js",
		"bench": "vite-node tools/bench.ts"
	},
	"devDependencies": {
		"prettier": "3.9.6",
		"typescript": "^5.7.2",
		"vite": "^6.0.7",
		"vitest": "^3.2.7"
	}
}
